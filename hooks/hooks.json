{
  "description": "Check the selected EvoZeus product channel and load the lightweight Lesson contract at Claude Code session boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),u=require('url');import(u.pathToFileURL(p.join(process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT,'hooks','session-start.mjs')).href)\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
