{
  "schema_version": "evozeus.session-signal.lesson-candidate-api-contract.v1",
  "api": "evozeus.session-signal.lesson-candidate.v1",
  "event_name": "UserPromptSubmit",
  "transport": "stdin_stdout_json",
  "request": {
    "required": [
      "schema_version",
      "event_name",
      "prompt",
      "targets"
    ],
    "optional": [
      "cwd"
    ],
    "limits": {
      "request_bytes": 262144,
      "prompt_chars": 32000,
      "targets": 256,
      "aliases_per_target": 32,
      "alias_chars": 128,
      "correction_requirements_chars": 12000
    },
    "target": {
      "required": ["repo", "canonical_path", "aliases"],
      "optional": ["correction_requirements"],
      "correction_requirements": "UTF-8 text copied from the registered Skill's feedback audit rule"
    }
  },
  "response": {
    "neutral_fields": [
      "schema_version",
      "candidate"
    ],
    "candidate_fields": [
      "schema_version",
      "candidate",
      "target_repo",
      "model_guidance"
    ]
  },
  "side_effects": {
    "persistence": false,
    "network": false
  },
  "method": {
    "candidate_gate": "A written correction_requirements rule must be available; prompt wording is not a deterministic signal.",
    "semantic_judgment": "The host model applies the Skill-authored rule to the current user turn.",
    "routing": "cwd containment first, then one unique alias; unresolved targets remain unassigned.",
    "missing_rule": "candidate=false"
  }
}
