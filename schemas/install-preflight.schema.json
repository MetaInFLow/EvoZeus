{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MetaInFLow/EvoZeus/schemas/install-preflight.schema.json",
  "title": "EvoZeus install preflight v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["stage"],
        "properties": { "stage": { "const": "full" } }
      },
      "then": { "required": ["target"] }
    }
  ],
  "required": [
    "ok",
    "operation",
    "schema_version",
    "stage",
    "checked_at",
    "writes",
    "status",
    "executor",
    "network",
    "local_state",
    "checks",
    "fallbacks",
    "blockers",
    "remediation",
    "next_action"
  ],
  "properties": {
    "ok": { "const": true },
    "operation": { "const": "system.installPreflight" },
    "schema_version": { "const": "evozeus.install-preflight.v1" },
    "stage": { "enum": ["pre_fetch", "full"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "writes": { "const": false },
    "status": { "enum": ["ready", "ready_with_fallbacks", "blocked"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "evozeus_home"],
      "properties": {
        "channel": { "enum": ["stable", "uat"] },
        "evozeus_home": { "type": "string" }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "product_asset", "checksum_required", "acquisition_requires_network"],
      "properties": {
        "kind": { "enum": ["inline_pre_fetch_gate", "verified_minimal_checker"] },
        "product_asset": { "const": false },
        "checksum_required": { "type": "boolean" },
        "acquisition_requires_network": { "type": "boolean" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_requests", "asset_get_count", "payloads_saved", "product_assets_downloaded"],
      "properties": {
        "head_requests": { "type": "integer", "minimum": 0 },
        "asset_get_count": { "enum": [0, 2] },
        "payloads_saved": { "enum": [0, 2] },
        "product_assets_downloaded": { "const": 0 }
      }
    },
    "local_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "preliminary", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "not_installed",
            "healthy_current",
            "update_available",
            "repair_required",
            "legacy_migration_required",
            "unknown_or_unverifiable"
          ]
        },
        "preliminary": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "fallbacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/fallback" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "remediation": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediation" }
    },
    "next_action": { "$ref": "#/$defs/nextAction" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requirement",
        "required",
        "phase",
        "status",
        "detected",
        "minimum_version",
        "alternatives",
        "remediation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["dependency", "environment", "network", "local_state"] },
        "requirement": { "enum": ["required", "required_one_of", "conditional"] },
        "required": { "type": "boolean" },
        "phase": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "enum": ["pass", "pass_with_fallback", "conditional", "fail", "not_run"] },
        "detected": {},
        "minimum_version": { "type": ["string", "null"] },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "remediation": { "type": "string" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "selected", "reason"],
      "properties": {
        "check_id": { "type": "string" },
        "selected": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "code", "message"],
      "properties": {
        "check_id": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "action"],
      "properties": {
        "check_id": { "type": "string" },
        "action": { "type": "string" }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "allowed",
        "writes_now",
        "product_asset_download_now",
        "registration_now",
        "approval_required"
      ],
      "properties": {
        "action": { "type": "string" },
        "allowed": { "type": "boolean" },
        "writes_now": { "const": false },
        "product_asset_download_now": { "const": false },
        "registration_now": { "const": false },
        "approval_required": { "type": "boolean" }
      }
    }
  }
}
