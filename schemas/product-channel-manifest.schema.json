{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evozeus.org/schemas/product-channel-manifest.v1.json",
  "title": "EvoZeus Product Channel Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "channel",
    "generated_at",
    "components",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "evozeus.product-channel.v1"
    },
    "product_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "channel": {
      "enum": ["stable", "uat"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evozeus", "infra", "coevolve", "session_signal"],
      "properties": {
        "evozeus": {"$ref": "#/$defs/component"},
        "infra": {"$ref": "#/$defs/component"},
        "coevolve": {"$ref": "#/$defs/component"},
        "session_signal": {"$ref": "#/$defs/component"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_min_inclusive", "runtime_max_exclusive", "coevolve_contract"],
      "properties": {
        "runtime_min_inclusive": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime_max_exclusive": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "coevolve_contract": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_url", "commit"],
      "properties": {
        "deployment_url": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "deployed_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "source", "required_paths"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "ref"],
          "properties": {
            "kind": {"enum": ["release_archive", "git"]},
            "url": {"type": "string", "format": "uri"},
            "ref": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "release_archive"}}},
              "then": {
                "properties": {"sha256": true},
                "required": ["sha256"]
              }
            }
          ]
        },
        "required_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    }
  }
}
